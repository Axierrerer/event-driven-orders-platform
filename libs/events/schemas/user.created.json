{
  "$defs": {
    "AuthProvider": {
      "enum": [
        "password",
        "google",
        "github"
      ],
      "title": "AuthProvider",
      "type": "string"
    },
    "UserCreatedPayload": {
      "additionalProperties": false,
      "properties": {
        "auth_provider": {
          "$ref": "#/$defs/AuthProvider"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "email": {
          "format": "email",
          "title": "Email",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "email",
        "created_at",
        "auth_provider"
      ],
      "title": "UserCreatedPayload",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "user.created",
      "default": "user.created",
      "title": "Event Type",
      "type": "string"
    },
    "event_version": {
      "default": 1,
      "minimum": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/UserCreatedPayload"
    },
    "producer": {
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    }
  },
  "required": [
    "producer",
    "correlation_id",
    "payload"
  ],
  "title": "UserCreated",
  "type": "object"
}
