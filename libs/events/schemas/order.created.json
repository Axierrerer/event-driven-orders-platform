{
  "$defs": {
    "OrderCreatedPayload": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/OrderItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "order_id": {
          "format": "uuid",
          "title": "Order Id",
          "type": "string"
        },
        "total_amount": {
          "pattern": "^\\d{1,10}\\.\\d{2}$",
          "title": "Total Amount",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "user_id",
        "items",
        "total_amount",
        "currency"
      ],
      "title": "OrderCreatedPayload",
      "type": "object"
    },
    "OrderItem": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "format": "uuid",
          "title": "Product Id",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "unit_price": {
          "pattern": "^\\d{1,10}\\.\\d{2}$",
          "title": "Unit Price",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "quantity",
        "unit_price"
      ],
      "title": "OrderItem",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "order.created",
      "default": "order.created",
      "title": "Event Type",
      "type": "string"
    },
    "event_version": {
      "default": 1,
      "minimum": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/OrderCreatedPayload"
    },
    "producer": {
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    }
  },
  "required": [
    "producer",
    "correlation_id",
    "payload"
  ],
  "title": "OrderCreated",
  "type": "object"
}
