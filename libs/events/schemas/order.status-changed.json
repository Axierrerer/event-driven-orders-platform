{
  "$defs": {
    "OrderStatus": {
      "enum": [
        "NEW",
        "RESERVED",
        "PAID",
        "SHIPPED",
        "COMPLETED",
        "CANCELLED"
      ],
      "title": "OrderStatus",
      "type": "string"
    },
    "OrderStatusChangedPayload": {
      "additionalProperties": false,
      "properties": {
        "changed_at": {
          "format": "date-time",
          "title": "Changed At",
          "type": "string"
        },
        "new_status": {
          "$ref": "#/$defs/OrderStatus"
        },
        "old_status": {
          "$ref": "#/$defs/OrderStatus"
        },
        "order_id": {
          "format": "uuid",
          "title": "Order Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "user_id",
        "old_status",
        "new_status",
        "changed_at"
      ],
      "title": "OrderStatusChangedPayload",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "order.status-changed",
      "default": "order.status-changed",
      "title": "Event Type",
      "type": "string"
    },
    "event_version": {
      "default": 1,
      "minimum": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/OrderStatusChangedPayload"
    },
    "producer": {
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    }
  },
  "required": [
    "producer",
    "correlation_id",
    "payload"
  ],
  "title": "OrderStatusChanged",
  "type": "object"
}
