# Шаблон локального окружения. Скопируйте в .env и меняйте только нужное:
# у всех переменных в docker-compose.yml есть значения по умолчанию для разработки.
# Здесь только dev-значения для локального стенда — НЕ реальные секреты.

# --- Порты на хосте (127.0.0.1) ---
GATEWAY_HOST_PORT=8000            # Nginx -> api-gateway
AUTH_SERVICE_HOST_PORT=8001
USER_SERVICE_HOST_PORT=8002
PRODUCT_SERVICE_HOST_PORT=8003
INVENTORY_SERVICE_HOST_PORT=8004
ORDER_SERVICE_HOST_PORT=8005
NOTIFICATION_SERVICE_HOST_PORT=8006
POSTGRES_HOST_PORT=5432
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9094
SCHEMA_REGISTRY_HOST_PORT=8081
MAILPIT_UI_HOST_PORT=8025

# --- PostgreSQL ---
POSTGRES_SUPERUSER_PASSWORD=local-dev-only
AUTH_DB_PASSWORD=local-dev-auth
USERS_DB_PASSWORD=local-dev-users
INVENTORY_DB_PASSWORD=local-dev-inventory
ORDERS_DB_PASSWORD=local-dev-orders

# --- Redis ---
REDIS_PASSWORD=local-dev-redis

# --- Пользователи стенда (scripts/seed.py) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=local-dev-admin-passphrase
SEED_MANAGER_PASSWORD=local-dev-manager-passphrase

# --- api-gateway ---
GATEWAY_REPLICAS=2                # реплик за Nginx
GATEWAY_ANONYMOUS_RATE_CAPACITY=40
GATEWAY_USER_RATE_CAPACITY=200

# --- Склад ---
RESERVATION_TTL_SECONDS=900       # срок резерва товара под неоплаченный заказ

# --- Observability (make obs-up задаёт сам) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=local-dev-grafana

# --- Общие ---
ENVIRONMENT=local
LOG_LEVEL=INFO
