# Скопируйте каталог в .secrets/dev (make inject-secrets сделает это сам при первом запуске)
# и замените значения. Каждый *.env превращается в Secret с тем же именем через SealedSecret.
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
AUTH_DB_PASSWORD=change-me-auth
USERS_DB_PASSWORD=change-me-users
INVENTORY_DB_PASSWORD=change-me-inventory
ORDERS_DB_PASSWORD=change-me-orders
REDIS_PASSWORD=change-me-redis
